{%- liquid
  assign kicker = section.settings.kicker | default: 'Drop 02'
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'next_drop.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'next_drop.text' | t
  endif
-%}
<section class="next gut" aria-labelledby="next-h-{{ section.id }}">
  <div class="next-in">
    <p class="up next-k">{{ kicker | escape }}</p>
    <h2 id="next-h-{{ section.id }}">{{ heading | escape }}</h2>
    <p class="next-p">{{ text | escape }}</p>
    {%- form 'customer', class: 'next-f', id: 'next-drop-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, proximo-drop">
      {%- if form.posted_successfully? -%}
        <p class="next-msg" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label for="next-email" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
        <input id="next-email" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.email' | t }}" required>
        <button type="submit" class="btn">{{ 'next_drop.button' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <p class="next-legal">{{ 'newsletter.legal_html' | t: privacy: shop.privacy_policy.url }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Próximo drop",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Drop 02" },
    { "type": "text", "id": "heading", "label": "Título (vacío = «Fecha por anunciar» traducido)" },
    { "type": "text", "id": "text", "label": "Texto (vacío = texto traducido)" }
  ],
  "presets": [{ "name": "Próximo drop" }]
}
{% endschema %}
