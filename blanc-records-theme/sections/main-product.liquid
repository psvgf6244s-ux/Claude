{%- assign current = product.selected_or_first_available_variant -%}
<section class="pdp gut" data-product>
  <div class="pdp__stage">
    <div class="pdp__slides zoomable" data-slides data-zoomable tabindex="0" aria-label="{{ 'products.zoom_hint' | t }}">
      <span class="zoom-hint" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.5 15.5L21 21M10.5 7.5v6M7.5 10.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
      {%- for media in product.media -%}
        <div class="pdp__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}" data-media-id="{{ media.id }}"{% if media.media_type == 'image' %} data-zoom="{{ media | image_url: width: 2400 }}"{% endif %}>
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                assign load = 'lazy'
                if forloop.first
                  assign load = 'eager'
                endif
              -%}
              {{ media | image_url: width: 1400 | image_tag:
                widths: '500, 800, 1100, 1400',
                sizes: '(min-width: 860px) 45vw, 100vw',
                loading: load,
                alt: media.alt | default: product.title }}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, playsinline: true }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div class="pdp__slide is-active">{{ 'apparel-1' | placeholder_svg_tag: 'placeholder' }}</div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="pdp__dots" role="group" aria-label="{{ 'products.gallery' | t }}">
        {%- for media in product.media -%}
          <button type="button" data-dot="{{ forloop.index0 }}" aria-label="{{ 'products.image_n' | t: n: forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="pdp__info">
    <nav class="crumbs" aria-label="Ruta"><a href="{{ routes.all_products_collection_url }}">{{ 'products.catalog' | t }}</a><span aria-hidden="true">/</span><span>{{ product.title | escape }}</span></nav>
    <div class="ph">
      <h1 class="pdp__title">{{ product.title | escape }}</h1>
      <p class="pdp__price" data-price>
        {%- if current.compare_at_price > current.price -%}<s>{{ current.compare_at_price | money }}</s> {% endif -%}
        {{ current.price | money }}
      </p>
    </div>
    {%- if cart.taxes_included -%}<p class="pdp__tax">{{ 'products.tax_included' | t }}</p>{%- endif -%}
    <div class="pdp__buy">
    {%- form 'product', product, class: 'pdp__form', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="sizes">
            <legend class="sz-l"><span class="up">{{ option.name | escape }}</span>{% if forloop.first %}<button type="button" class="sz-g" data-open-guide>{{ 'products.size_chart' | t }}</button>{% endif %}</legend>{% if forloop.first %}<p class="rec" data-rec hidden></p>{% endif %}
            <div class="sizes__row">
              {%- for value in option.values -%}
                <label class="size">
                  <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %} data-option="{{ forloop.parentloop.index0 }}">
                  <span>{{ value | escape }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}
      <p class="fit">{{ 'products.fit_note' | t }}</p>
      <button type="submit" name="add" class="btn btn--block" data-add{% unless current.available %} disabled{% endunless %}>
        <span data-add-label>{%- if current.available -%}{{ 'products.add_to_cart' | t }} — {{ current.price | money }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
      </button>
      {%- liquid
        assign low_text = ''
        if current.inventory_management == 'shopify' and current.inventory_policy == 'deny' and current.inventory_quantity > 0 and current.inventory_quantity <= section.settings.low_stock
          if current.inventory_quantity == 1
            assign low_text = 'products.last_one' | t: size: current.title
          else
            assign low_text = 'products.low_stock' | t: size: current.title
          endif
        endif
      -%}
      <p class="low" data-low{% if low_text == blank %} hidden{% endif %}>{{ low_text }}</p>
      <p class="note" role="status" data-status></p>
      {{ form | payment_terms }}
    {%- endform -%}
    </div>
    {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="paysafe">
        <span><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>{{ 'products.secure_payment' | t }}</span>
        <ul class="paysafe__icons">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pay pay--sm' }}</li>{%- endfor -%}</ul>
      </div>
    {%- endif -%}
    <div class="acc">
      <details open>
        <summary class="up">{{ 'products.details' | t }}</summary>
        <div class="acc__body rte">{{ product.description }}</div>
      </details>
      {%- capture guide -%}{% render 'size-guide', product: product %}{%- endcapture -%}
      {%- if guide != blank or section.settings.size_chart_page != blank -%}
        <details data-guide-acc>
          <summary class="up">{{ 'products.size_chart' | t }}</summary>
          <div class="acc__body rte">{%- if guide != blank -%}{{ guide }}{%- else -%}{{ section.settings.size_chart_page.content }}{%- endif -%}</div>
        </details>
      {%- endif -%}
      <details>
        <summary class="up">{{ 'products.care' | t }}</summary>
        <div class="acc__body rte">
          {%- if product.metafields.custom.cuidado != blank -%}{{ product.metafields.custom.cuidado | metafield_tag }}{%- else -%}{{ 'products.care_body' | t }}{%- endif -%}
        </div>
      </details>
      {%- if section.settings.shipping_page != blank -%}
        <details>
          <summary class="up">{{ 'products.shipping_returns' | t }}</summary>
          <div class="acc__body rte">
            {{ section.settings.shipping_page.content | strip_html | truncatewords: 60 }}
            <p><a href="{{ section.settings.shipping_page.url }}">{{ 'products.read_more' | t }}</a></p>
          </div>
        </details>
      {%- else -%}
        <details>
          <summary class="up">{{ 'products.shipping_returns' | t }}</summary>
          <div class="acc__body rte">{{ 'products.shipping_body' | t }} <a href="{{ routes.root_url }}pages/hacer-una-devolucion">{{ 'footer.make_return' | t }}</a></div>
        </details>
      {%- endif -%}
    </div>
    <p class="help">{{ 'products.more_help' | t }} <a href="{{ routes.root_url }}pages/faq">{{ 'products.see_faq' | t }}</a></p>
  </div>

  <script type="application/json" data-variants>
    {{ product.variants | json }}
  </script>
  <script type="application/json" data-stock>
    {%- capture stock -%}{%- for v in product.variants -%}{%- if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' -%}"{{ v.id }}":{{ v.inventory_quantity }},{%- endif -%}{%- endfor -%}{%- endcapture -%}
    {"limit":{{ section.settings.low_stock }},"qty":{ {{ stock | remove_last: ',' }} }}
  </script>
  <script type="application/json" data-strings>
    {"low": {{ 'products.low_stock' | t: size: '__S__' | json }}, "last": {{ 'products.last_one' | t: size: '__S__' | json }}, "choose": {{ 'products.choose_size' | t | json }}, "add": {{ 'products.add_to_cart' | t | json }}, "soldOut": {{ 'products.sold_out' | t | json }}, "unavailable": {{ 'products.unavailable' | t | json }}, "added": {{ 'products.added' | t | json }}, "error": {{ 'products.error' | t | json }}, "moneyFormat": {{ shop.money_format | json }}}
  </script>


  <div class="sticky-buy" data-sticky-buy hidden>
    {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: alt: '', width: 40, height: 50 }}{%- endif -%}
    <div class="sb-info"><span class="sb-n">{{ product.title | escape }}</span><span class="sb-p" data-sb-price>{{ current.price | money }}</span></div>
    <button class="btn" type="button" data-sb-btn>{{ 'products.add_to_cart' | t }}</button>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_media -%}"image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
  "description": {{ product.description | strip_html | json }},
  "brand": {"@type": "Brand", "name": {{ product.vendor | json }}},
  "offers": [
    {%- for variant in product.variants -%}
    {"@type": "Offer", "sku": {{ variant.sku | json }}, "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}", "price": {{ variant.price | divided_by: 100.00 | json }}, "priceCurrency": {{ cart.currency.iso_code | json }}, "url": {{ request.origin | append: variant.url | json }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{%- liquid
  assign related_count = 0
-%}
<section class="related gut">
  <h2 class="h-up">{{ 'products.related' | t }}</h2>
  <div class="grid" style="--cols: 4;">
    {%- for p in collections.all.products -%}
      {%- if p.id != product.id and related_count < 4 -%}
        {%- assign related_count = related_count | plus: 1 -%}
        {% render 'product-card', product: p %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Ficha de producto",
  "settings": [
    { "type": "page", "id": "size_chart_page", "label": "Página con la guía de tallas" },
    { "type": "page", "id": "shipping_page", "label": "Página de envíos y devoluciones" },
    { "type": "range", "id": "low_stock", "label": "Avisar «quedan pocas» con este stock o menos", "min": 1, "max": 10, "step": 1, "default": 3 }
  ]
}
{% endschema %}
