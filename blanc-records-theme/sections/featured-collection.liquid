{%- assign col = section.settings.collection | default: collections.all -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'home.drop_heading' | t
  endif
  assign subheading = section.settings.subheading
  if subheading == blank
    assign subheading = 'home.drop_sub' | t
  endif
-%}
<section class="arrivals gut" id="catalogo">
  <h2 class="h-up">{{ heading | escape }}</h2>
  <p class="sub">{{ subheading | escape }}</p>
  {%- capture type_list -%}{%- for p in col.products limit: section.settings.limit -%}{{ p.type | handle }}::{{ p.type }}{% unless forloop.last %}||{% endunless %}{%- endfor -%}{%- endcapture -%}
  {%- assign types = type_list | split: '||' | uniq -%}
  {%- if types.size > 1 -%}
    <div class="chips-f" role="group" aria-label="{{ 'filters.label' | t }}" data-filters>
      <button type="button" data-f="all" aria-pressed="true">{{ 'filters.all' | t }}</button>
      {%- for t_ in types -%}
        {%- assign parts = t_ | split: '::' -%}
        {%- if parts[0] != blank -%}
          {%- capture key -%}filters.{{ parts[0] | replace: '-', '_' }}{%- endcapture -%}
          {%- assign label = key | t -%}
          {%- if label contains 'translation missing' -%}{%- assign label = parts[1] -%}{%- endif -%}
          <button type="button" data-f="{{ parts[0] }}" aria-pressed="false">{{ label }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  <div class="grid" style="--cols: {{ section.settings.columns }};">
    {%- for product in col.products limit: section.settings.limit -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="card"><div class="card__media">{{ 'apparel-1' | placeholder_svg_tag: 'placeholder' }}</div><span class="card__title">{{ 'products.example' | t }}</span><span class="card__price">{{ 8900 | money }}</span></div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.show_all and col.products_count > section.settings.limit -%}
    <p class="more"><a class="btn" href="{{ col.url }}">{{ 'collections.view_all' | t }}</a></p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (vacío = «Drop 01» traducido)" },
    { "type": "text", "id": "subheading", "label": "Subtítulo (vacío = texto traducido)" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Productos", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columnas en ordenador", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_all", "label": "Botón 'Ver todo'", "default": true }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
