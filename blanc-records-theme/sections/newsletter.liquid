<section class="news gut" id="newsletter">
  {%- if section.settings.heading != blank -%}<h2 class="news__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.text != blank -%}<p class="news__text">{{ section.settings.text | escape }}</p>{%- endif -%}
  {%- form 'customer', class: 'news__form', id: 'newsletter-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      <p class="note" role="status">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <div class="news__row">
        <label for="newsletter-email" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
        <input id="newsletter-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required>
        <button type="submit" class="btn">{{ 'newsletter.subscribe' | t }}</button>
      </div>
      <p class="news__legal">{{ 'newsletter.legal_html' | t: privacy: shop.privacy_policy.url }}</p>
      {%- if form.errors -%}<p class="note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que se graba una vez no se repite." },
    { "type": "text", "id": "text", "label": "Texto", "default": "Apúntate y te avisamos antes de que salga el próximo drop." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
