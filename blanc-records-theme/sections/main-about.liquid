<section class="page gut">
  <h1 class="h-up">{{ page.title | escape }}</h1>
  <figure class="about-hero">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 800px) 760px, 100vw', alt: section.settings.image.alt | default: shop.name }}
    {%- else -%}
      <img src="{{ 'hero.jpg' | asset_url }}" alt="{{ shop.name | escape }}" loading="lazy" width="3344" height="1882">
    {%- endif -%}
  </figure>
  <div class="rte page__body">{{ page.content }}</div>
</section>

{% schema %}
{
  "name": "Sobre la marca",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen (vacío = foto de la portada)" }
  ]
}
{% endschema %}
