<section class="pw gut">
  <p class="giant giant--pw">{% render 'wordmark' %}</p>
  <h1 class="h-up">{{ 'general.password_title' | t }}</h1>
  <p class="sub">{%- if shop.password_message != blank -%}{{ shop.password_message }}{%- else -%}{{ 'general.password_text' | t }}{%- endif -%}</p>
  {%- form 'customer', class: 'news__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, prelanzamiento">
    {%- if form.posted_successfully? -%}
      <p class="note" role="status">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <div class="news__row">
        <label for="pw-email" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
        <input id="pw-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required>
        <button type="submit" class="btn">{{ 'newsletter.subscribe' | t }}</button>
      </div>
      <p class="news__legal">{{ 'newsletter.legal_html' | t: privacy: shop.privacy_policy.url }}</p>
    {%- endif -%}
  {%- endform -%}
  <details class="pw__login">
    <summary class="up">{{ 'general.password_enter' | t }}</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p class="note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="news__row">
        <label for="pw-pass" class="visually-hidden">{{ 'general.password_label' | t }}</label>
        <input id="pw-pass" type="password" name="password" placeholder="{{ 'general.password_label' | t }}" required>
        <button type="submit" class="btn">{{ 'general.password_submit' | t }}</button>
      </div>
    {%- endform -%}
  </details>
</section>

{% schema %}
{ "name": "Página de contraseña", "settings": [] }
{% endschema %}
