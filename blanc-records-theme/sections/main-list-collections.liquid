<section class="arrivals gut">
  <h1 class="h-up">{{ 'collections.all_title' | t }}</h1>
  <div class="grid" style="--cols: 3;">
    {%- for collection in collections -%}
      {%- if collection.products_count > 0 -%}
      <a class="card" href="{{ collection.url }}">
        <div class="card__media">
          {%- assign img = collection.featured_image | default: collection.products.first.featured_media -%}
          {%- if img -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', class: 'card__img', alt: collection.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
        </div>
        <span class="card__title">{{ collection.title | escape }}</span>
        <span class="card__price">{{ 'collections.count' | t: count: collection.products_count }}</span>
      </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Lista de colecciones", "settings": [] }
{% endschema %}
