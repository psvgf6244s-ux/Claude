<footer class="foot" id="contacto">
  <div class="foot-top gut">
    <nav class="f-col" aria-label="{{ 'footer.info' | t }}">
      <p class="f-h">{{ 'footer.info' | t }}</p>
      {%- if section.settings.menu_info.links.size > 0 -%}
        {%- for link in section.settings.menu_info.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}pages/contact">{{ 'footer.contact' | t }}</a>
        {%- if shop.shipping_policy -%}<a href="{{ shop.shipping_policy.url }}">{{ 'footer.shipping' | t }}</a>{%- endif -%}
        {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">{{ 'footer.returns' | t }}</a>{%- endif -%}
        <a href="{{ routes.root_url }}pages/hacer-una-devolucion">{{ 'footer.make_return' | t }}</a>
        <a href="{{ routes.root_url }}pages/faq">{{ 'footer.faq' | t }}</a>
        <a href="{{ routes.root_url }}pages/sobre-blanc">{{ 'footer.about' | t }}</a>
      {%- endif -%}
    </nav>

    <div class="f-col f-mid">
      <nav class="f-legal" aria-label="{{ 'accessibility.legal_nav' | t }}">
        <p class="f-h">{{ 'footer.legal' | t }}</p>
        {%- if section.settings.menu_legal.links.size > 0 -%}
          {%- for link in section.settings.menu_legal.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
        {%- else -%}
          {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">{{ 'footer.terms' | t }}</a>{%- endif -%}
          {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">{{ 'footer.privacy' | t }}</a>{%- endif -%}
          <a href="{{ routes.root_url }}pages/cookies">{{ 'footer.cookies_policy' | t }}</a>
          {%- if shop.legal_notice_policy -%}<a href="{{ shop.legal_notice_policy.url }}">{{ 'footer.legal_notice' | t }}</a>{%- endif -%}
        {%- endif -%}
        <button type="button" class="f-cookies" data-cookie-prefs>{{ 'footer.cookies' | t }}</button>
      </nav>
      <a class="f-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}, {{ 'header.home' | t }}">{% render 'logo-mark' %}<span>{{ settings.wordmark_text | default: shop.name | upcase | escape }}{% if settings.wordmark_registered %}<sup class="reg">®</sup>{% endif %}</span></a>
      {%- if settings.social_instagram != blank or settings.social_tiktok != blank -%}
        <ul class="f-social" aria-label="{{ 'footer.follow' | t }}">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/></svg></a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="currentColor"/></svg></a></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="f-col f-news">
      <p class="f-h">{%- if section.settings.news_heading != blank -%}{{ section.settings.news_heading | escape }}{%- else -%}{{ 'footer.news_heading' | t }}{%- endif -%}</p>
      {%- form 'customer', id: 'footer-newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="f-msg" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <label for="footer-email" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
          <input id="footer-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required>
          <button type="submit">{{ 'newsletter.subscribe' | t }}</button>
          {%- if form.errors -%}<p class="f-msg" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <p class="f-small">{{ 'newsletter.legal_html' | t: privacy: shop.privacy_policy.url }}</p>
    </div>
  </div>

  <div class="foot-bot gut">
    <div class="f-loc">
      {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'f-loc-form' -%}
          {%- if localization.available_countries.size > 1 -%}
            <label class="visually-hidden" for="f-country">{{ 'footer.country' | t }}</label>
            <span class="f-sel"><span class="flag-img" aria-hidden="true">{{ localization.country | image_url: width: 52 | image_tag: width: 26, height: 17, alt: '' }}</span>
            <select id="f-country" name="country_code" onchange="this.form.submit()">
              {%- for c in localization.available_countries -%}
                <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>
              {%- endfor -%}
            </select></span>
          {%- endif -%}
          {%- if localization.available_languages.size > 1 -%}
            <label class="visually-hidden" for="f-lang">{{ 'footer.language' | t }}</label>
            <span class="f-sel"><select id="f-lang" name="locale_code" onchange="this.form.submit()">
              {%- for l in localization.available_languages -%}
                <option value="{{ l.iso_code }}"{% if l.iso_code == localization.language.iso_code %} selected{% endif %}>{{ l.endonym_name | capitalize }}</option>
              {%- endfor -%}
            </select></span>
          {%- endif -%}
        {%- endform -%}
      {%- else -%}
        <span class="f-sel f-static"><span class="flag-img" aria-hidden="true">{{ localization.country | image_url: width: 52 | image_tag: width: 26, height: 17, alt: '' }}</span>{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span>
        <span class="f-sel f-static">{{ localization.language.endonym_name | capitalize }}</span>
      {%- endif -%}
    </div>
    <p class="f-copy">© {{ 'now' | date: '%Y' }} · {{ settings.wordmark_text | default: shop.name | upcase | escape }}</p>
    {%- if section.settings.show_payment -%}
      <ul class="f-pay" aria-label="{{ 'footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pay' }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "link_list", "id": "menu_info", "label": "Menú «Info» (vacío = Contacto, Envíos, Devoluciones)" },
    { "type": "link_list", "id": "menu_legal", "label": "Menú «Legal» (vacío = políticas de la tienda)" },
    { "type": "text", "id": "news_heading", "label": "Título de la suscripción (vacío = texto traducido)" },
    { "type": "checkbox", "id": "show_payment", "label": "Mostrar métodos de pago", "default": true }
  ]
}
{% endschema %}
