<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
  {%- endif -%}
  <title>
    {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>
  {%- liquid
    assign meta_desc = page_description | default: shop.description
    if meta_desc == blank
      assign meta_desc = 'general.meta_description' | t
    endif
  -%}
  <meta name="description" content="{{ meta_desc | escape }}">
  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {%- assign heading_font = settings.type_heading -%}
  {%- assign body_font = settings.type_body -%}
  {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  <style>
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign heading_bold = heading_font | font_modify: 'weight', 'bolder' -%}
    {{ heading_bold | font_face: font_display: 'swap' }}
    :root{
      --bg: {{ settings.color_bg }};
      --fg: {{ settings.color_fg }};
      --dim: {{ settings.color_dim }};
      --line: {{ settings.color_line }};
      --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {"@type": "Organization", "@id": {{ request.origin | append: '/#org' | json }}, "name": {{ settings.wordmark_text | default: shop.name | json }}, "url": {{ request.origin | append: routes.root_url | json }}, "logo": {{ 'apple-touch-icon.png' | asset_url | prepend: 'https:' | json }}{% if settings.social_instagram != blank or settings.social_tiktok != blank %}, "sameAs": [{% if settings.social_instagram != blank %}{{ settings.social_instagram | json }}{% endif %}{% if settings.social_instagram != blank and settings.social_tiktok != blank %},{% endif %}{% if settings.social_tiktok != blank %}{{ settings.social_tiktok | json }}{% endif %}]{% endif %}},
        {"@type": "WebSite", "name": {{ settings.wordmark_text | default: shop.name | json }}, "url": {{ request.origin | append: routes.root_url | json }}, "potentialAction": {"@type": "SearchAction", "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }}, "query-input": "required name=search_term_string"}}{% if request.page_type == 'product' %},
        {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": {{ 'products.catalog' | t | json }}, "item": {{ request.origin | append: routes.all_products_collection_url | json }}}, {"@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }}}]}{% endif %}
      ]
    }
  </script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#main">{{ 'accessibility.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'cart-sheet' %}
</body>
</html>
