<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{{ shop.name }}</title>
  {%- assign heading_font = settings.type_heading -%}
  {%- assign body_font = settings.type_body -%}
  <style>
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ body_font | font_face: font_display: 'swap' }}
    :root{--bg:{{ settings.color_bg }};--fg:{{ settings.color_fg }};--dim:{{ settings.color_dim }};--line:{{ settings.color_line }};
      --font-heading:{{ heading_font.family }},{{ heading_font.fallback_families }};--font-body:{{ body_font.family }},{{ body_font.fallback_families }};}
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
