{%- comment -%}
  Guía de tallas según el tipo de producto. Medidas del tech pack, en cm, prenda en plano.
  Uso: {% render 'size-guide', product: product %}
{%- endcomment -%}
{%- liquid
  assign type = product.type | downcase
  assign draw = ''
  if type contains 'manga larga'
    assign draw = 'ls'
    assign cols = 'Pecho,Largo,Manga'
    assign rows = 'S:58,64,69|M:60,66,71|L:62,68,72|XL:64,70,74'
  elsif type contains 'sudadera'
    assign draw = 'hoodie'
    assign cols = 'Pecho,Largo,Manga'
    assign rows = 'S:62,57,73|M:64,59,75|L:66,61,77|XL:68,63,79'
  elsif type contains 'camiseta'
    assign draw = 'tee'
    assign cols = 'Pecho,Largo,Hombros'
    assign rows = 'S:58,62,54|M:60,64,56|L:62,66,58|XL:64,68,60'
  endif
-%}
{%- if rows -%}
  {%- case draw -%}
    {%- when 'tee' -%}<svg class="sg-draw" viewBox="0 0 220 210" role="img" aria-label="Cómo se mide la camiseta" font-family="inherit"><g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"><path d="M65 44 L90 34 Q110 52 130 34 L155 44 L196 84 L178 104 L155 88 L155 190 L65 190 L65 88 L42 104 L24 84 Z"/><path d="M90 34 Q110 44 130 34" opacity=".5"/><path d="M80 52 Q86 120 78 190 M140 52 Q134 120 142 190" opacity=".35"/></g><line x1="65" y1="26" x2="155" y2="26" stroke="#c8372d" stroke-width="1.6"/><circle cx="65" cy="26" r="2.4" fill="#c8372d"/><circle cx="155" cy="26" r="2.4" fill="#c8372d"/><text x="110" y="19" fill="#c8372d" font-size="10" font-weight="700" letter-spacing=".04em" text-anchor="middle">HOMBROS</text><line x1="65" y1="100" x2="155" y2="100" stroke="#c8372d" stroke-width="1.6"/><circle cx="65" cy="100" r="2.4" fill="#c8372d"/><circle cx="155" cy="100" r="2.4" fill="#c8372d"/><text x="110" y="95" fill="#c8372d" font-size="10" font-weight="700" letter-spacing=".04em" text-anchor="middle">PECHO</text><line x1="170" y1="44" x2="170" y2="190" stroke="#c8372d" stroke-width="1.6"/><circle cx="170" cy="44" r="2.4" fill="#c8372d"/><circle cx="170" cy="190" r="2.4" fill="#c8372d"/><text x="182" y="117" transform="rotate(90 182 117)" fill="#c8372d" font-size="10" font-weight="700" letter-spacing=".04em" text-anchor="middle">LARGO</text></svg>
    {%- when 'ls' -%}<svg class="sg-draw" viewBox="0 0 220 210" role="img" aria-label="Cómo se mide la camiseta de manga larga" font-family="inherit"><g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"><path d="M92 32 Q110 46 128 32 L156 40 Q180 62 196 178 L174 184 L156 96 L152 190 L68 190 L64 96 L46 184 L24 178 Q40 62 64 40 Z"/><path d="M92 32 L68 82 M128 32 L152 82" opacity=".45"/><path d="M92 32 Q110 42 128 32" opacity=".5"/></g><line x1="68" y1="104" x2="152" y2="104" stroke="#c8372d" stroke-width="1.6"/><circle cx="68" cy="104" r="2.4" fill="#c8372d"/><circle cx="152" cy="104" r="2.4" fill="#c8372d"/><text x="110" y="99" fill="#c8372d" font-size="10" font-weight="700" letter-spacing=".04em" text-anchor="middle">PECHO</text><line x1="110" y1="40" x2="110" y2="190" stroke="#c8372d" stroke-width="1.6"/><circle cx="110" cy="40" r="2.4" fill="#c8372d"/><circle cx="110" cy="190" r="2.4" fill="#c8372d"/><text x="101" y="150" transform="rotate(-90 101 150)" fill="#c8372d" font-size="10" font-weight="700" letter-spacing=".04em" text-anchor="middle">LARGO</text><line x1="128" y1="30" x2="188" y2="182" stroke="#c8372d" stroke-width="1.6"/><circle cx="128" cy="30" r="2.4" fill="#c8372d"/><circle cx="188" cy="182" r="2.4" fill="#c8372d"/><text x="172" y="98" transform="rotate(68 172 98)" fill="#c8372d" font-size="10" font-weight="700" letter-spacing=".04em" text-anchor="middle">MANGA</text></svg>
    {%- when 'hoodie' -%}<svg class="sg-draw" viewBox="0 0 220 210" role="img" aria-label="Cómo se mide la sudadera" font-family="inherit"><g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"><path d="M80 50 Q76 10 110 10 Q144 10 140 50"/><path d="M62 54 L84 46 Q110 60 136 46 L158 54 Q182 80 194 170 L174 176 L158 104 L158 176 L62 176 L62 104 L46 176 L26 170 Q38 80 62 54 Z"/><path d="M110 56 L110 190 M62 176 L62 190 L158 190 L158 176 M84 140 L136 140 L142 166 L78 166 Z" opacity=".5"/></g><line x1="62" y1="108" x2="158" y2="108" stroke="#c8372d" stroke-width="1.6"/><circle cx="62" cy="108" r="2.4" fill="#c8372d"/><circle cx="158" cy="108" r="2.4" fill="#c8372d"/><text x="110" y="103" fill="#c8372d" font-size="10" font-weight="700" letter-spacing=".04em" text-anchor="middle">PECHO</text><line x1="140" y1="54" x2="140" y2="190" stroke="#c8372d" stroke-width="1.6"/><circle cx="140" cy="54" r="2.4" fill="#c8372d"/><circle cx="140" cy="190" r="2.4" fill="#c8372d"/><text x="151" y="140" transform="rotate(90 151 140)" fill="#c8372d" font-size="10" font-weight="700" letter-spacing=".04em" text-anchor="middle">LARGO</text><line x1="160" y1="56" x2="186" y2="172" stroke="#c8372d" stroke-width="1.6"/><circle cx="160" cy="56" r="2.4" fill="#c8372d"/><circle cx="186" cy="172" r="2.4" fill="#c8372d"/><text x="190" y="104" transform="rotate(77 190 104)" fill="#c8372d" font-size="10" font-weight="700" letter-spacing=".04em" text-anchor="middle">MANGA</text></svg>
  {%- endcase -%}
  {%- assign col_list = cols | split: ',' -%}
  <table>
    <tr><th>Talla</th>{% for c in col_list %}<th>{{ c }}</th>{% endfor %}</tr>
    {%- assign row_list = rows | split: '|' -%}
    {%- for r in row_list -%}
      {%- assign parts = r | split: ':' -%}
      <tr><td>{{ parts[0] }}</td>{% assign vals = parts[1] | split: ',' %}{% for v in vals %}<td>{{ v }}</td>{% endfor %}</tr>
    {%- endfor -%}
  </table>
  <p>Medidas de la prenda en cm, tomadas en plano. Corte amplio: si dudas entre dos tallas, coge la tuya.</p>
{%- endif -%}
