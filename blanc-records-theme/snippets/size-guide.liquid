{%- comment -%}
  Guía de tallas según el tipo de producto: dibujo de cómo se mide y tabla.
  Medidas del tech pack, en cm, prenda en plano. Uso: {% render 'size-guide', product: product %}
{%- endcomment -%}
{%- liquid
  assign type = product.type | downcase
  assign kind = ''
  if type contains 'manga larga'
    assign kind = 'ls'
  elsif type contains 'sudadera'
    assign kind = 'hoodie'
  elsif type contains 'camiseta'
    assign kind = 'tee'
  endif
-%}
{%- if kind != '' -%}
<script type="application/json" data-ff-strings>{"bad": {{ 'size_guide.ff_bad' | t | json }}, "result": {{ 'size_guide.ff_result' | t | json }}, "same": {{ 'size_guide.ff_same' | t | json }}, "more": {{ 'size_guide.ff_more' | t | json }}, "less": {{ 'size_guide.ff_less' | t | json }}, "small": {{ 'size_guide.ff_small' | t | json }}, "big": {{ 'size_guide.ff_big' | t | json }}, "pick": {{ 'size_guide.ff_pick' | t | json }}}</script>
{%- endif -%}
{%- case kind -%}
  {%- when 'tee' -%}
<div class="sg"><svg class="sg-draw" viewBox="0 0 240 236" role="img" aria-label="{{ 'size_guide.how' | t }}"><defs><marker id="ar-tee" viewBox="0 0 10 10" refX="9.2" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M1.5 1.5 L9 5 L1.5 8.5" fill="none" stroke="#c8372d" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker></defs><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M98 34 Q120 51 142 34 L166 42 L206 84 L186 107 L170 95 L170 218 L70 218 L70 95 L54 107 L34 84 L74 42 Z"/><path d="M98 34 Q120 44 142 34" opacity=".45"/></g><line x1="74" y1="40" x2="74" y2="18" stroke="#c8372d" stroke-width=".9" stroke-dasharray="2 2.5"/><line x1="166" y1="40" x2="166" y2="18" stroke="#c8372d" stroke-width=".9" stroke-dasharray="2 2.5"/><line x1="74" y1="24" x2="166" y2="24" stroke="#c8372d" stroke-width="1.3" marker-start="url(#ar-tee)" marker-end="url(#ar-tee)"/><text x="120" y="17" fill="#c8372d" font-size="9" font-weight="700" letter-spacing=".08em" text-anchor="middle" style="paint-order:stroke;stroke:var(--bg,#fff);stroke-width:4px;stroke-linejoin:round">{{ 'size_guide.shoulders' | t | upcase }}</text><line x1="70" y1="114" x2="170" y2="114" stroke="#c8372d" stroke-width="1.3" marker-start="url(#ar-tee)" marker-end="url(#ar-tee)"/><text x="120" y="107" fill="#c8372d" font-size="9" font-weight="700" letter-spacing=".08em" text-anchor="middle" style="paint-order:stroke;stroke:var(--bg,#fff);stroke-width:4px;stroke-linejoin:round">{{ 'size_guide.chest' | t | upcase }}</text><line x1="144" y1="34" x2="226" y2="34" stroke="#c8372d" stroke-width=".9" stroke-dasharray="2 2.5"/><line x1="172" y1="218" x2="226" y2="218" stroke="#c8372d" stroke-width=".9" stroke-dasharray="2 2.5"/><line x1="220" y1="34" x2="220" y2="218" stroke="#c8372d" stroke-width="1.3" marker-start="url(#ar-tee)" marker-end="url(#ar-tee)"/><text x="232" y="126" transform="rotate(-90 232 126)" fill="#c8372d" font-size="9" font-weight="700" letter-spacing=".08em" text-anchor="middle" style="paint-order:stroke;stroke:var(--bg,#fff);stroke-width:4px;stroke-linejoin:round">{{ 'size_guide.length' | t | upcase }}</text></svg><table><tr><th>{{ 'size_guide.size' | t }}</th><th>{{ 'size_guide.chest' | t }}</th><th>{{ 'size_guide.length' | t }}</th><th>{{ 'size_guide.shoulders' | t }}</th></tr><tr data-row="S"><td>S</td><td>58</td><td>62</td><td>54</td></tr><tr data-row="M"><td>M</td><td>60</td><td>64</td><td>56</td></tr><tr data-row="L"><td>L</td><td>62</td><td>66</td><td>58</td></tr><tr data-row="XL"><td>XL</td><td>64</td><td>68</td><td>60</td></tr></table><p>{{ 'size_guide.note' | t }}</p><div class="ff" data-ff='{"S":58,"M":60,"L":62,"XL":64}'><p class="ff-t">{{ 'size_guide.ff_title' | t }}</p><p class="ff-d">{{ 'size_guide.ff_desc' | t }}</p><div class="ff-row"><label for="ff-in-tee">{{ 'size_guide.ff_label' | t }}<input id="ff-in-tee" type="number" inputmode="decimal" min="40" max="80" step="0.5" placeholder="58" data-ff-in></label><button type="button" class="btn" data-ff-go>{{ 'size_guide.ff_go' | t }}</button></div><p class="ff-out" role="status" data-ff-out></p></div></div>
  {%- when 'ls' -%}
<div class="sg"><svg class="sg-draw" viewBox="0 0 240 236" role="img" aria-label="{{ 'size_guide.how' | t }}"><defs><marker id="ar-ls" viewBox="0 0 10 10" refX="9.2" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M1.5 1.5 L9 5 L1.5 8.5" fill="none" stroke="#c8372d" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker></defs><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M100 30 Q120 45 140 30 L170 40 Q196 72 214 200 L190 206 L170 110 L168 214 L72 214 L70 110 L50 206 L26 200 Q44 72 70 40 Z"/><path d="M100 30 L72 88 M140 30 L168 88" opacity=".4"/><path d="M100 30 Q120 40 140 30" opacity=".45"/></g><line x1="71" y1="122" x2="169" y2="122" stroke="#c8372d" stroke-width="1.3" marker-start="url(#ar-ls)" marker-end="url(#ar-ls)"/><text x="124" y="115" fill="#c8372d" font-size="9" font-weight="700" letter-spacing=".08em" text-anchor="middle" style="paint-order:stroke;stroke:var(--bg,#fff);stroke-width:4px;stroke-linejoin:round">{{ 'size_guide.chest' | t | upcase }}</text><line x1="100" y1="30" x2="84" y2="30" stroke="#c8372d" stroke-width=".9" stroke-dasharray="2 2.5"/><line x1="88" y1="30" x2="88" y2="214" stroke="#c8372d" stroke-width="1.3" marker-start="url(#ar-ls)" marker-end="url(#ar-ls)"/><text x="97" y="168" transform="rotate(-90 97 168)" fill="#c8372d" font-size="9" font-weight="700" letter-spacing=".08em" text-anchor="middle" style="paint-order:stroke;stroke:var(--bg,#fff);stroke-width:4px;stroke-linejoin:round">{{ 'size_guide.length' | t | upcase }}</text><line x1="142" y1="28" x2="204" y2="200" stroke="#c8372d" stroke-width="1.3" marker-start="url(#ar-ls)" marker-end="url(#ar-ls)"/><text x="196" y="150" transform="rotate(71 196 150)" fill="#c8372d" font-size="9" font-weight="700" letter-spacing=".08em" text-anchor="middle" style="paint-order:stroke;stroke:var(--bg,#fff);stroke-width:4px;stroke-linejoin:round">{{ 'size_guide.sleeve' | t | upcase }}</text></svg><table><tr><th>{{ 'size_guide.size' | t }}</th><th>{{ 'size_guide.chest' | t }}</th><th>{{ 'size_guide.length' | t }}</th><th>{{ 'size_guide.sleeve' | t }}</th></tr><tr data-row="S"><td>S</td><td>58</td><td>64</td><td>69</td></tr><tr data-row="M"><td>M</td><td>60</td><td>66</td><td>71</td></tr><tr data-row="L"><td>L</td><td>62</td><td>68</td><td>72</td></tr><tr data-row="XL"><td>XL</td><td>64</td><td>70</td><td>74</td></tr></table><p>{{ 'size_guide.note' | t }}</p><div class="ff" data-ff='{"S":58,"M":60,"L":62,"XL":64}'><p class="ff-t">{{ 'size_guide.ff_title' | t }}</p><p class="ff-d">{{ 'size_guide.ff_desc' | t }}</p><div class="ff-row"><label for="ff-in-ls">{{ 'size_guide.ff_label' | t }}<input id="ff-in-ls" type="number" inputmode="decimal" min="40" max="80" step="0.5" placeholder="58" data-ff-in></label><button type="button" class="btn" data-ff-go>{{ 'size_guide.ff_go' | t }}</button></div><p class="ff-out" role="status" data-ff-out></p></div></div>
  {%- when 'hoodie' -%}
<div class="sg"><svg class="sg-draw" viewBox="0 0 240 236" role="img" aria-label="{{ 'size_guide.how' | t }}"><defs><marker id="ar-hoodie" viewBox="0 0 10 10" refX="9.2" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M1.5 1.5 L9 5 L1.5 8.5" fill="none" stroke="#c8372d" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker></defs><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M88 46 Q84 8 120 8 Q156 8 152 46"/><path d="M70 52 L94 43 Q120 58 146 43 L170 52 Q196 82 210 196 L188 202 L170 114 L170 200 L70 200 L70 114 L52 202 L30 196 Q44 82 70 52 Z"/><path d="M70 200 L70 214 L170 214 L170 200" /><path d="M120 58 L120 214 M90 160 L150 160 L156 190 L84 190 Z" opacity=".4"/></g><line x1="71" y1="124" x2="169" y2="124" stroke="#c8372d" stroke-width="1.3" marker-start="url(#ar-hoodie)" marker-end="url(#ar-hoodie)"/><text x="145" y="117" fill="#c8372d" font-size="9" font-weight="700" letter-spacing=".08em" text-anchor="middle" style="paint-order:stroke;stroke:var(--bg,#fff);stroke-width:4px;stroke-linejoin:round">{{ 'size_guide.chest' | t | upcase }}</text><line x1="94" y1="44" x2="94" y2="214" stroke="#c8372d" stroke-width="1.3" marker-start="url(#ar-hoodie)" marker-end="url(#ar-hoodie)"/><text x="86" y="90" transform="rotate(-90 86 90)" fill="#c8372d" font-size="9" font-weight="700" letter-spacing=".08em" text-anchor="middle" style="paint-order:stroke;stroke:var(--bg,#fff);stroke-width:4px;stroke-linejoin:round">{{ 'size_guide.length' | t | upcase }}</text><line x1="172" y1="53" x2="203" y2="196" stroke="#c8372d" stroke-width="1.3" marker-start="url(#ar-hoodie)" marker-end="url(#ar-hoodie)"/><text x="178.5" y="142" transform="rotate(78 178.5 142)" fill="#c8372d" font-size="9" font-weight="700" letter-spacing=".08em" text-anchor="middle" style="paint-order:stroke;stroke:var(--bg,#fff);stroke-width:4px;stroke-linejoin:round">{{ 'size_guide.sleeve' | t | upcase }}</text></svg><table><tr><th>{{ 'size_guide.size' | t }}</th><th>{{ 'size_guide.chest' | t }}</th><th>{{ 'size_guide.length' | t }}</th><th>{{ 'size_guide.sleeve' | t }}</th></tr><tr data-row="S"><td>S</td><td>62</td><td>57</td><td>73</td></tr><tr data-row="M"><td>M</td><td>64</td><td>59</td><td>75</td></tr><tr data-row="L"><td>L</td><td>66</td><td>61</td><td>77</td></tr><tr data-row="XL"><td>XL</td><td>68</td><td>63</td><td>79</td></tr></table><p>{{ 'size_guide.note' | t }}</p><div class="ff" data-ff='{"S":62,"M":64,"L":66,"XL":68}'><p class="ff-t">{{ 'size_guide.ff_title' | t }}</p><p class="ff-d">{{ 'size_guide.ff_desc' | t }}</p><div class="ff-row"><label for="ff-in-hoodie">{{ 'size_guide.ff_label' | t }}<input id="ff-in-hoodie" type="number" inputmode="decimal" min="40" max="80" step="0.5" placeholder="58" data-ff-in></label><button type="button" class="btn" data-ff-go>{{ 'size_guide.ff_go' | t }}</button></div><p class="ff-out" role="status" data-ff-out></p></div></div>
{%- endcase -%}
