{%- comment -%}
  Tarjeta de producto. Uso: {% render 'product-card', product: product %}
{%- endcomment -%}
<a class="card" href="{{ product.url }}">
  <div class="card__media">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag:
        loading: 'lazy',
        widths: '300, 450, 600, 900',
        sizes: '(min-width: 900px) 25vw, 50vw',
        alt: product.featured_media.alt | default: product.title,
        class: 'card__img' }}
      {%- if product.media[1] -%}
        {{ product.media[1] | image_url: width: 900 | image_tag:
          loading: 'lazy',
          widths: '300, 450, 600, 900',
          sizes: '(min-width: 900px) 25vw, 50vw',
          alt: '',
          class: 'card__img card__img--alt' }}
      {%- endif -%}
    {%- else -%}
      {{ 'apparel-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
    {%- unless product.available -%}<span class="badge">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
  </div>
  <span class="card__title">{{ product.title | escape }}</span>
  <span class="card__price">
    {%- if product.compare_at_price > product.price -%}
      <s>{{ product.compare_at_price | money }}</s>
    {%- endif -%}
    {%- if product.price_varies -%}{{ 'products.from' | t }} {% endif -%}{{ product.price | money }}
  </span>
</a>
