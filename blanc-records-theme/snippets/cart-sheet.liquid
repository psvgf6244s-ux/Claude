{%- comment -%}
  Carrito que sale por la derecha al añadir una prenda o al pulsar el carrito.
  El contenido lo rellena assets/theme.js con /cart.js y /collections/all/products.json.
{%- endcomment -%}
<div class="sheet-bg" hidden data-sheet
  data-money-format="{{ shop.money_format | escape }}"
  data-free="{{ settings.free_ship_threshold | default: 0 | times: 100 }}"
  data-strings='{"title":{{ 'cart.title' | t | json | escape }},"empty":{{ 'cart.empty' | t | json | escape }},"size":{{ 'sheet.size' | t | json | escape }},"remove_one":{{ 'sheet.remove_one' | t | json | escape }},"add_one":{{ 'sheet.add_one' | t | json | escape }},"checkout":{{ 'cart.checkout' | t | json | escape }},"add_size":{{ 'sheet.add_size' | t | json | escape }},"error":{{ 'products.error' | t | json | escape }},"added":{{ 'sheet.added' | t | json | escape }},"remove":{{ 'sheet.remove' | t | json | escape }},"removed":{{ 'sheet.removed' | t: name: '__NAME__' | json | escape }},"see_all":{{ 'sheet.see_all' | t | json | escape }},"fs_left":{{ 'sheet.fs_left' | t | json | escape }},"fs_done":{{ 'sheet.fs_done' | t | json | escape }}}'>
  <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
    <header class="sheet-h">
      <strong id="sheet-title" data-sheet-title>{{ 'cart.title' | t }}</strong>
      <button class="x" type="button" aria-label="{{ 'sheet.close' | t }}" data-sheet-close><span></span><span></span></button>
    </header>
    <p class="added" role="status" data-sheet-added hidden></p>
    <div class="fs" data-fs hidden><p data-fs-t aria-live="polite"></p><div class="fs-bar" aria-hidden="true"><i data-fs-i></i></div></div>
    <div class="sheet-body">
      <div class="sec"><p class="sec-t">{{ 'sheet.your_order' | t }}</p><div data-sheet-lines></div></div>
      <div class="undo" role="status" data-sheet-undo hidden><span></span><button type="button" data-sheet-undo-btn>{{ 'sheet.undo' | t }}</button></div>
      <div class="ups-wrap sec" data-sheet-ups-wrap hidden>
        <div class="ups-h"><p class="sec-t">{{ 'sheet.complete_look' | t }}</p><div class="ups-nav" data-ups-nav><button type="button" class="ups-arr" data-ups-step="-1" aria-label="{{ 'sheet.prev' | t }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button><button type="button" class="ups-arr" data-ups-step="1" aria-label="{{ 'sheet.next' | t }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></div>
        <div class="ups-row" data-sheet-ups></div>
      </div>
    </div>
    <footer class="sheet-f" data-sheet-foot>
      <div class="tot"><span class="up">{{ 'cart.subtotal' | t }}</span><strong data-sheet-total>{{ cart.total_price | money }}</strong></div>
      <p class="ship">{{ 'sheet.taxes_shipping' | t }}</p>
      <div class="acts">
        <a class="btn" href="{{ routes.root_url }}checkout" data-sheet-checkout>{{ 'cart.checkout' | t }}</a>
        <button class="btn btn--ghost" type="button" data-sheet-close>{{ 'sheet.keep' | t }}</button>
      </div>
      <ul class="trust">
        <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>{{ 'sheet.trust_pay' | t }}</li>
        <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8a5 5 0 1 0 1.5-3.6M3 2.5V5h2.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>{{ 'sheet.trust_returns' | t }}</li>
        <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.5 4.5h8v6h-8zM9.5 7h3l2 2v1.5h-5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="4.5" cy="11.5" r="1.2" fill="currentColor"/><circle cx="12" cy="11.5" r="1.2" fill="currentColor"/></svg>{{ 'sheet.trust_ship' | t }}</li>
      </ul>
      <p class="sheet-legal">{{ 'sheet.legal_html' | t: terms: shop.terms_of_service.url, privacy: shop.privacy_policy.url }}</p>
      <p class="note" role="status" data-sheet-note></p>
    </footer>
  </section>
</div>
