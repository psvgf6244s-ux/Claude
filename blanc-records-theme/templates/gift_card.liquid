{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} · Tarjeta regalo</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="page gut page--center">
    <h1 class="h-up">{{ shop.name }}</h1>
    <p class="sub">Tarjeta regalo de {{ gift_card.initial_value | money }}</p>
    {%- if gift_card.enabled and gift_card.expired == false -%}
      <p>Saldo: <strong>{{ gift_card.balance | money }}</strong></p>
      <p>Código: <code style="user-select:all">{{ gift_card.code | format_code }}</code></p>
      {%- if gift_card.expires_on -%}<p class="note">Caduca el {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>{%- endif -%}
      <p><a class="btn" href="{{ shop.url }}">Ir a la tienda</a></p>
    {%- else -%}
      <p class="note">Esta tarjeta regalo no está activa o ha caducado.</p>
    {%- endif -%}
  </main>
</body>
</html>
