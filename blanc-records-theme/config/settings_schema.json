[
  {
    "name": "theme_info",
    "theme_name": "Blanc",
    "theme_version": "1.0.0",
    "theme_author": "BLANC RECORDS",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Marca",
    "settings": [
      {
        "type": "text",
        "id": "wordmark_text",
        "label": "Nombre del logotipo",
        "default": "Blanc Records"
      },
      {
        "type": "checkbox",
        "id": "wordmark_registered",
        "label": "Mostrar ® tras el nombre (solo si la marca está registrada en la OEPM/EUIPO)",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Fondo",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_fg",
        "label": "Texto",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "color_dim",
        "label": "Texto secundario",
        "default": "#636363"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Líneas",
        "default": "#e3e3e3"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading",
        "label": "Títulos",
        "default": "inter_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body",
        "label": "Texto",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      }
    ]
  },
  {
    "name": "Pop-up de descuento",
    "settings": [
      {
        "type": "checkbox",
        "id": "popup_enable",
        "label": "Mostrar pop-up de bienvenida",
        "default": true
      },
      {
        "type": "text",
        "id": "popup_code",
        "label": "Código de descuento (créalo antes en Descuentos)",
        "default": "BLANC10"
      },
      {
        "type": "range",
        "id": "popup_percent",
        "label": "Porcentaje que se muestra",
        "min": 5,
        "max": 50,
        "step": 5,
        "unit": "%",
        "default": 10
      },
      {
        "type": "range",
        "id": "popup_delay",
        "label": "Segundos hasta que aparece (solo sale una vez por persona)",
        "min": 2,
        "max": 30,
        "step": 1,
        "unit": "s",
        "default": 8
      },
      {
        "type": "image_picker",
        "id": "popup_image",
        "label": "Foto (si no, la del inicio)"
      },
      {
        "type": "checkbox",
        "id": "popup_reel",
        "label": "Fotos del logo cambiando rápido (efecto vídeo)",
        "default": true
      },
      {
        "type": "range",
        "id": "popup_reel_speed",
        "label": "Velocidad del cambio de fotos",
        "min": 150,
        "max": 800,
        "step": 50,
        "unit": "ms",
        "default": 250
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "number",
        "id": "free_ship_threshold",
        "label": "Envío gratis a partir de (€). 0 = no mostrar la barra",
        "default": 55,
        "info": "Debe coincidir con la tarifa de Ajustes > Envío y entrega (ahora: gratis desde 55 € en España)."
      },
      {
        "type": "text",
        "id": "free_ship_country",
        "label": "País con envío gratis (código de 2 letras)",
        "default": "ES",
        "info": "La barra solo se muestra a quien compra desde este país."
      }
    ]
  }
]